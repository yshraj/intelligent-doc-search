# =============================================================================
# LiveDocAI – Environment Variables (Phase 1)
# =============================================================================
# 1. Copy: cp .env.example .env
# 2. Fill every value. See docs/ENV_SETUP.md
# 3. Never commit .env
# =============================================================================

# Supabase (Auth, Database, Storage)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated

# Qdrant Cloud (vector store)
QDRANT_URL=
QDRANT_API_KEY=

# Gemini API (embeddings + chat)
GEMINI_API_KEY=  # For embeddings and text generation via LangChain
GEMINI_API_KEY_2=  # Optional: Backup key

# Backend
PORT=8000

# Generation Settings (Optional)
MAX_OUTPUT_TOKENS=2048  # Maximum tokens for LLM responses (default: 2048, max: 8192 for Gemini)
RETRIEVAL_TOP_K=8  # Number of chunks to retrieve (default: 8, balanced for 2048 token limit)

# Frontend: copy to frontend/.env with VITE_ prefix (public only)
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=<same as SUPABASE_ANON_KEY>
# VITE_API_URL=http://localhost:8000
